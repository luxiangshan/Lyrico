{
  "id": "com.lyrico.test.mockmeta",
  "name": "@plugin.name",
  "versionCode": 1,
  "versionName": "1.0",
  "author": "Lyrico Mod tests",
  "description": "@plugin.description",
  "apiVersion": 5,
  "minHostApiVersion": 4,
  "entry": "source.js",
  "includeDirs": [
    "lib"
  ],
  "capabilities": [
    "searchSongs",
    "getLyrics",
    "searchCovers"
  ],
  "configFields": [
    {
      "key": "baseUrl",
      "title": "@config.baseUrl",
      "type": "text",
      "defaultValue": "http://127.0.0.1:9/"
    }
  ],
  "i18n": {
    "defaultLocale": "en",
    "resources": {
      "en": "locales/en.json",
      "zh-Hans": "locales/zh-Hans.json"
    }
  }
}
